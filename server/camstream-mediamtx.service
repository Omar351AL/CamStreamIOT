[Unit]
Description=CamStream MediaMTX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camstream
Group=camstream
WorkingDirectory=/opt/camstream
ExecStart=/opt/camstream/mediamtx /opt/camstream/mediamtx.yml
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
