#!/bin/bash
# Relays the camera's H.264 RTSP stream to the CamStream server without re-encoding.
# With no CAMERA_RTSP it publishes a test pattern so the whole chain can be checked.
# Output goes over SRT when PUBLISH_SRT is set (better on lossy 4G), otherwise RTSP/TCP.
# Settings come from /etc/camstream/relay.env (see relay.env.example).
set -u

if [ -n "${PUBLISH_SRT:-}" ]; then
  OUT=(-f mpegts -flush_packets 1 "$PUBLISH_SRT")
else
  OUT=(-f rtsp -rtsp_transport tcp "$PUBLISH_URL")
fi

if [ -n "${CAMERA_RTSP:-}" ]; then
  exec ffmpeg -nostdin -loglevel warning \
    -fflags +genpts -use_wallclock_as_timestamps 1 \
    -rtsp_transport tcp -timeout 10000000 -i "$CAMERA_RTSP" \
    -map 0:v:0 -an -c:v copy \
    "${OUT[@]}"
else
  exec ffmpeg -nostdin -loglevel warning -re \
    -f lavfi -i "testsrc2=size=640x360:rate=15" \
    -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline -pix_fmt yuv420p -g 30 \
    "${OUT[@]}"
fi
