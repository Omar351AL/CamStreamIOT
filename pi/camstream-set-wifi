#!/bin/bash
# Saves the Wi-Fi network the Pi should use for internet (name + password, or no password),
# then switches to it. Run it over SSH, e.g. while connected to the "CamStream-Setup" hotspot:
#   ssh -t omaral351@10.42.0.1 camstream-set-wifi
# The password is read silently and only stored in NetworkManager (root-only).
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

echo "Networks the Pi can see:"
nmcli -t -f SSID,SIGNAL,SECURITY dev wifi list --rescan auto 2>/dev/null | awk -F: '$1!="" {printf "  %-28s signal %3s  %s\n", $1, $2, ($3==""?"open":$3)}' | sort -u -k1,1 | head -15
echo

read -rp "Wi-Fi name: " SSID
[ -n "$SSID" ] || { echo "No name given, nothing changed."; exit 1; }
read -rsp "Password (leave empty for an open network): " PASS; echo

NAME="camstream-wifi-$SSID"
nmcli con delete "$NAME" >/dev/null 2>&1 || true
if [ -n "$PASS" ]; then
  nmcli con add type wifi ifname wlan0 con-name "$NAME" ssid "$SSID" \
    wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PASS" \
    connection.autoconnect yes connection.autoconnect-priority 10 >/dev/null
else
  nmcli con add type wifi ifname wlan0 con-name "$NAME" ssid "$SSID" \
    connection.autoconnect yes connection.autoconnect-priority 10 >/dev/null
fi
echo "Saved \"$SSID\". Saved networks (highest priority is tried first):"
nmcli -t -f NAME,TYPE,AUTOCONNECT-PRIORITY con show | awk -F: '$2=="802-11-wireless" && $1!="camstream-setup" {printf "  %s (priority %s)\n", $1, $3}'

echo
echo "Switching to \"$SSID\" now. If you are connected through the setup hotspot, it will drop;"
echo "the Pi comes back on its own hotspot after about 2 minutes if \"$SSID\" cannot be joined."
sleep 2
nmcli con down camstream-setup >/dev/null 2>&1 || true
if nmcli --wait 40 con up "$NAME" >/dev/null 2>&1; then
  echo "Connected to \"$SSID\"."
else
  echo "Could not join \"$SSID\" right now (check the name and password)."
fi
