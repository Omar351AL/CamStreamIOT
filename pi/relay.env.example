# Copy to /etc/camstream/relay.env on the Pi (root-only, mode 600). Never commit the real file.
# Leave CAMERA_RTSP empty to publish a test pattern instead of the camera.
CAMERA_RTSP=
# rtsp://admin:<CAMERA_PASSWORD>@192.168.50.2:554/cam/realmonitor?channel=1&subtype=0
PUBLISH_URL=rtsp://publisher:<PUBLISHER_PASS>@camstream.omaralabed.com:8554/camera1
